# Copy this file to .env and adjust values for your environment.
# Never commit the resulting .env file.
#
# The values below are development defaults. Generate fresh values before
# sharing an environment or deploying: python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_SECRET_KEY=dev-only-django-secret-key-change-before-production-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,identity,offers,applications,internships,notifications
DJANGO_CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# Authentication secrets shared by the services.
# JWT_SIGNING_KEY signs user access tokens (identity issues them, the other
# services verify them). SERVICE_JWT_SIGNING_KEY is only for trusted
# service-to-service calls.
JWT_SIGNING_KEY=dev-only-user-jwt-signing-key-change-me-0123456789
SERVICE_JWT_SIGNING_KEY=dev-only-service-jwt-signing-key-change-me-0123456789
SERVICE_JWT_ISSUER=stagelink-services
SERVICE_JWT_AUDIENCE=stagelink-identity
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-change-me

# Shared development database credentials.
# Each service still owns its own database; see infra/docker/docker-compose.yml.
POSTGRES_USER=stagelink
POSTGRES_PASSWORD=stagelink

# Internal service URL used by applications when a student accepts an offer.
INTERNSHIP_SERVICE_URL=http://internships:8000/api/internal/internships/

# Service base URLs (useful for integration tests and local clients).
IDENTITY_BASE_URL=http://localhost:8001
OFFERS_BASE_URL=http://localhost:8002
APPLICATIONS_BASE_URL=http://localhost:8003
INTERNSHIPS_BASE_URL=http://localhost:8004
NOTIFICATIONS_BASE_URL=http://localhost:8005

# Frontend (reserved)
FRONTEND_BASE_URL=http://localhost:3000
