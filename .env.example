# Copy this file to .env and adjust values for your environment.
# Never commit the resulting .env file.
#
# The values below are development defaults. Generate fresh values before
# sharing an environment or deploying: python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_SECRET_KEY=dev-only-django-secret-key-change-before-production-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,identity,offers,applications,internships,notifications
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call the APIs from a browser. The front end runs on 3000
# locally; list every deployed origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Set to true only behind a TLS-terminating proxy that overwrites
# X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=false

# Local demo and integration tests use generous login/registration limits.
# Set these to 10/minute and 10/hour in production.
LOGIN_THROTTLE_RATE=1000/minute
REGISTER_THROTTLE_RATE=1000/hour

# Authentication secrets shared by the services.
# JWT_SIGNING_KEY signs user access tokens (identity issues them, the other
# services verify them). INTERNAL_SERVICE_TOKEN is the shared secret sent in
# the X-Service-Token header on trusted service-to-service calls.
JWT_SIGNING_KEY=dev-only-user-jwt-signing-key-change-me-0123456789
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-change-me

# Shared development database credentials.
# Each service still owns its own database; see infra/docker/docker-compose.yml.
POSTGRES_USER=stagelink
POSTGRES_PASSWORD=stagelink

# Internal service URLs used by applications.
# - Offers: intake validation and the capacity guard.
# - Internships: internship creation when a student accepts.
INTERNSHIP_SERVICE_URL=http://internships:8000/api/internal/internships/
OFFERS_SERVICE_URL=http://offers:8000/api/internal/offers/

# Internships uploads. Files are stored on the internships-media volume and are
# only reachable through the authorised download endpoint.
MAX_SUBMISSION_SIZE_BYTES=10485760
# Fallback university administrators, as comma-separated UUIDs. Applications
# and Internships resolve administrators from the Identity directory; this list
# is used only when Identity is unavailable.
UNIVERSITY_ADMIN_USER_IDS=

# Service base URLs (useful for integration tests and local clients).
# OFFERS_BASE_URL is also used by the Identity seed_demo command.
IDENTITY_BASE_URL=http://localhost:8001
OFFERS_BASE_URL=http://localhost:8002
APPLICATIONS_BASE_URL=http://localhost:8003
INTERNSHIPS_BASE_URL=http://localhost:8004
NOTIFICATIONS_BASE_URL=http://localhost:8005

# Frontend (reserved)
FRONTEND_BASE_URL=http://localhost:3000
