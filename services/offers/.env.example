DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave DB_ENGINE unset to use SQLite for local unit tests.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=offers
DB_USER=stagelink
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Must match the user JWT signing key used by Identity & Profiles.
JWT_SIGNING_KEY=replace-with-the-shared-user-jwt-signing-key
JWT_USER_ID_CLAIM=user_id
JWT_ROLE_CLAIM=role
