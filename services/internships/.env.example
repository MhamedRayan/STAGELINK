DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
# Set to true only behind a proxy that overwrites X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=false

# Leave DB_ENGINE unset to use SQLite for local unit tests.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=internships
DB_USER=stagelink
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Shared secret used by other services in the X-Service-Token header.
INTERNAL_SERVICE_TOKEN=replace-with-the-shared-internal-service-token

# Must match the user JWT signing key used by Identity & Profiles.
JWT_SIGNING_KEY=replace-with-the-shared-user-jwt-signing-key

# Identity & Profiles internal directory, used to verify supervisors before
# assignment and to resolve university-administrator notification recipients.
IDENTITY_BASE_URL=http://localhost:8001
IDENTITY_TIMEOUT_SECONDS=5
# Successful directory lookups are cached; failures are cached briefly so an
# outage does not add a lookup to every notification.
IDENTITY_DIRECTORY_CACHE_SECONDS=60
IDENTITY_DIRECTORY_ERROR_CACHE_SECONDS=10

# Uploaded student submissions. Never served directly: downloads are authorised.
MEDIA_ROOT=media
MAX_SUBMISSION_SIZE_BYTES=10485760

# Notifications service. Delivery is best effort and never blocks the change.
NOTIFICATIONS_BASE_URL=http://localhost:8005
NOTIFICATIONS_TIMEOUT_SECONDS=5
NOTIFICATIONS_ENABLED=true

# Applications service, used to release a place after an approved cancellation.
APPLICATIONS_BASE_URL=http://localhost:8003
APPLICATIONS_TIMEOUT_SECONDS=5

# Outage fallback for university administrators who receive cancellation
# notifications, as comma-separated UUIDs. Identity's directory is the primary
# source; this list is used only when Identity is unavailable.
UNIVERSITY_ADMIN_USER_IDS=
