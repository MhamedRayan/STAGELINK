# Copy to .env and fill in real values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT validation: agree on these values with the Identity & Profiles service.
# HS256 = shared secret; RS256 = public key in PEM (newlines written as \n).
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=replace-with-the-shared-user-jwt-signing-key
JWT_USER_ID_CLAIM=user_id
JWT_ROLE_CLAIM=role

# Shared secret sent by other services in the X-Service-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=replace-with-the-shared-internal-service-token

# Leave DB_ENGINE unset to use SQLite; use PostgreSQL in shared environments.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=notifications
DB_USER=stagelink
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Development-only: trust the X-User-Id header when no Bearer token is sent.
# Defaults to the value of DJANGO_DEBUG. Never enable it in production.
DEV_AUTH_ENABLED=True
