DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_PROXY_SSL_HEADER=false
# Either set DATABASE_URL as below, or omit it and set DB_ENGINE/DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT.
DATABASE_URL=postgresql://stagelink_identity:replace-me@localhost:5432/stagelink_identity

# Share JWT_SIGNING_KEY with services that validate user access tokens.
JWT_SIGNING_KEY=replace-with-a-distinct-long-random-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Local development and integration testing use generous limits. Set these to
# 10/hour and 10/minute before exposing the service to the internet.
LOGIN_THROTTLE_RATE=1000/minute
REGISTER_THROTTLE_RATE=1000/hour

# Shared secret sent by trusted services in the X-Service-Token header.
INTERNAL_SERVICE_TOKEN=replace-with-the-shared-internal-service-token

# Used only by `manage.py seed_demo` to create and publish the demo offer
# through the Offers HTTP API. Identity never calls Offers while serving
# requests.
OFFERS_BASE_URL=http://localhost:8002
OFFERS_TIMEOUT_SECONDS=5

TIME_ZONE=UTC
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
