DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_PROXY_SSL_HEADER=false

# Leave DB_ENGINE unset to use SQLite for local unit tests.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=applications
DB_USER=stagelink
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Must match the user JWT signing key used by Identity & Profiles.
JWT_SIGNING_KEY=replace-with-the-shared-user-jwt-signing-key

# Synchronous call to Internship Management when an application is confirmed.
INTERNSHIP_SERVICE_URL=http://localhost:8004/api/internal/internships/
INTERNSHIP_TIMEOUT_SECONDS=5
INTERNSHIP_CREATION_ATTEMPTS=3

# Internal offer lookup used to validate intake and derive the owning company.
OFFERS_SERVICE_URL=http://localhost:8002/api/internal/offers/
OFFERS_TIMEOUT_SECONDS=5

# Identity role directory, used to resolve university-administrator recipients.
# The lookup is best effort, runs after commit, and is cached briefly.
IDENTITY_BASE_URL=http://localhost:8001
IDENTITY_TIMEOUT_SECONDS=2
IDENTITY_DIRECTORY_CACHE_SECONDS=60
IDENTITY_DIRECTORY_ERROR_CACHE_SECONDS=10

# Best-effort notifications, sent after the business transaction commits.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_BASE_URL=http://localhost:8005
NOTIFICATIONS_TIMEOUT_SECONDS=5
NOTIFICATIONS_MAX_ATTEMPTS=3

# Fallback university administrators, as comma-separated UUIDs. The Identity
# directory is the primary source; this list is used only during an outage.
UNIVERSITY_ADMIN_USER_IDS=

INTERNAL_SERVICE_TOKEN=replace-with-the-shared-internal-service-token
