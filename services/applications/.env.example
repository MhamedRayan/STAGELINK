DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave DB_ENGINE unset to use SQLite for local unit tests.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=applications
DB_USER=stagelink
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# Must match the user JWT signing key used by Identity & Profiles.
JWT_SIGNING_KEY=replace-with-the-shared-user-jwt-signing-key
JWT_USER_ID_CLAIM=user_id

# Synchronous call to Internship Management when an application is confirmed.
INTERNSHIP_SERVICE_URL=http://localhost:8004/api/internal/internships/
INTERNAL_SERVICE_TOKEN=replace-with-the-shared-internal-service-token
